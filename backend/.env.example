# ═══════════════════════════════════════════════════════════════
# Finclusion AI 2.0 — Environment Variables
# Copy this file to .env and fill in the values
# ═══════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────
POSTGRES_URL=postgresql://user:password@localhost:5432/finclusion
MONGODB_URL=mongodb://localhost:27017/finclusion

# ── AI / LLM ─────────────────────────────────────────────────
HUGGINGFACE_API_KEY=hf_your_api_key_here
HUGGINGFACE_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.3
OPENAI_API_KEY=sk-your-openai-key-here  # Optional fallback

# ── Embeddings ────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chroma_db
FAISS_INDEX_DIR=./data/faiss_index

# ── Financial APIs ────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
NSE_API_URL=https://www.nseindia.com/api
MFAPI_URL=https://api.mfapi.in
NEWSAPI_KEY=your_newsapi_key
RAPID_API_KEY=your_rapidapi_key

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ── App Settings ──────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

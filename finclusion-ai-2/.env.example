# ==========================================
# FINCLUSION AI 2.0 - ENVIRONMENT VARIABLES
# ==========================================
# WARNING: Do not commit the actual .env file to version control.
# Copy this file to .env and replace the placeholders.

# --- Database Configurations ---
DATABASE_URL=postgresql://finclusion_user:securepassword@localhost:5432/finclusion_db

# --- Authentication & Security ---
JWT_SECRET_KEY=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- LLM & AI Models ---
HUGGINGFACE_API_KEY=hf_your_huggingface_api_key_here
LLM_API_KEY=your_llm_api_key_here # E.g., Groq, OpenAI, or Anthropic depending on chosen LangChain provider

# --- Market Data & News APIs ---
MARKET_DATA_API_KEY=your_yfinance_or_alpha_vantage_key
NEWS_API_KEY=your_news_api_key

# --- External Services ---
FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"..."} # Optional if using Firebase for frontend auth instead of JWT

# --- Environment ---
ENVIRONMENT=development # development | staging | production
